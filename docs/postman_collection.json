      "name": "6. Persistência (teste manual)",
      "item": [
        {
          "name": "GET /orders/:id — verificar após reiniciar a API",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "/* Rode este depois de reiniciar a aplicação:",
                  "   docker compose restart   ou   podman-compose restart",
                  "   O pedido criado no passo 2 deve continuar disponível. */",
                  "pm.test('Status 200 após reinício', () => pm.response.to.have.status(200));",
                  "pm.test('Pedido continua no banco (SQLite em volume)', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('order_id'));",
                  "    pm.expect(body.total_cents).to.equal(2598);",
                  "});",
                  "pm.test('order_id definido — rode o passo 2 antes', () => {",
                  "    pm.expect(pm.collectionVariables.get('order_id')).to.not.be.empty;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}"
              ]
            },
            "description": "Crie o pedido no passo 2, reinicie o contêiner (`docker compose restart`) e envie este request. Ele deve continuar respondendo 200 com o mesmo pedido."
          }
        }
      ]
    }
