{
  "info": {
    "name": "API de pedidos — Projeto B",
    "description": "Coleção da API de pedidos: importe no Postman e use base_url http://localhost:8080. Execute as pastas 1 a 5 na ordem pelo Runner; o pedido criado é salvo em order_id. A pasta 6 é manual: reinicie a API antes de executá-la.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "order_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Saúde e métricas",
      "item": [
        {
          "name": "GET /health — aplicação de pé",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type é JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^application\\/json\\b/));",
                  "pm.test('Corpo retorna status ok', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.be.an('object');",
                  "    pm.expect(body.status).to.eql('ok');",
                  "    pm.expect(Object.keys(body)).to.eql(['status']);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        },
        {
          "name": "GET /metrics — métrica Prometheus",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type é text/plain', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^text\\/plain\\b/));",
                  "pm.test('Expõe o contador orders_http_requests_total', () => {",
                  "    pm.expect(pm.response.text()).to.include('# TYPE orders_http_requests_total counter');",
                  "    pm.expect(pm.response.text()).to.match(/orders_http_requests_total\\{method=\"(GET|POST)\",route=\"[^\"]+\",status=\"\\d+\"\\} \\d+/);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/metrics",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "metrics"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Fluxo principal",
      "item": [
        {
          "name": "POST /orders — criar pedido (valida total)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset('order_id');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
                  "pm.test('Content-Type é JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.match(/^application\\/json\\b/));",
                  "pm.test('Resposta contém id, items e total_cents', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.all.keys('id', 'items', 'total_cents');",
                  "    pm.expect(body.id).to.be.a('string');",
                  "    pm.expect(body.id).to.have.lengthOf(36);",
                  "});",
                  "pm.test('Total calculado no servidor: 2 x 1299 = 2598', () => {",
                  "    pm.expect(pm.response.json().total_cents).to.equal(2598);",
                  "});",
                  "pm.test('Itens são devolvidos normalizados', () => {",
                  "    const items = pm.response.json().items;",
                  "    pm.expect(items).to.have.lengthOf(1);",
                  "    pm.expect(items[0]).to.eql({ name: 'Livro', quantity: 2, unit_price_cents: 1299 });",
                  "});",
                  "pm.test('Sem campos extras na resposta', () => {",
                  "    pm.expect(Object.keys(pm.response.json())).to.have.members(['id', 'items', 'total_cents']);",
                  "});",
                  "const id = pm.response.json().id;",
                  "pm.collectionVariables.set('order_id', id);",
                  "pm.test('order_id salvo para os próximos requests', () => pm.expect(pm.collectionVariables.get('order_id')).to.eql(id));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"name\": \"Livro\", \"quantity\": 2, \"unit_price_cents\": 1299 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "POST /orders — pedido com vários itens",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Total soma todos os itens: (2 x 1299) + (5 x 199) = 3593', () => {",
                  "    pm.expect(pm.response.json().total_cents).to.equal(3593);",
                  "});",
                  "pm.test('Todos os itens presentes', () => {",
                  "    pm.expect(pm.response.json().items).to.have.lengthOf(3);",
                  "});",
                  "pm.test('Preço zero é aceito (total não vira NaN)', () => {",
                  "    pm.expect(pm.response.json().total_cents).to.be.a('number');",
                  "    pm.expect(Number.isFinite(pm.response.json().total_cents)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"name\": \"Livro\", \"quantity\": 2, \"unit_price_cents\": 1299 },\n    { \"name\": \"Caneta\", \"quantity\": 5, \"unit_price_cents\": 199 },\n    { \"name\": \"Adesivo\", \"quantity\": 1, \"unit_price_cents\": 0 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders"
              ]
            }
          }
        },
        {
          "name": "GET /orders/:id — consultar pedido criado",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('O pedido consultado é o mesmo criado', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.id).to.eql(pm.collectionVariables.get('order_id'));",
                  "    pm.expect(body.total_cents).to.equal(2598);",
                  "    pm.expect(body.items[0].name).to.equal('Livro');",
                  "});",
                  "pm.test('Resposta contém os campos esperados', () => {",
                  "    pm.expect(pm.response.json()).to.have.all.keys('id', 'items', 'total_cents');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/orders/{{order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "orders",
                "{{order_id}}"
              ]
            }
          }
        },
        {
